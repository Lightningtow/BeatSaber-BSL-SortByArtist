<?xml version="1.0" encoding="utf-8"?>
<!-- This file contains project properties used by the build. -->
<Project>

	<!-- Plugin Metadata -->
	<PropertyGroup>
		<PluginId>BetterSongList-ArtistSort</PluginId>
		<PluginName>BetterSongList-ArtistSort</PluginName>
		<Authors>Lightningtow</Authors>
		<Version>1.0.1</Version>
		<GameVersion>1.40.8</GameVersion>
		<Description>Adds sort by artist to BetterSongList</Description>
		<!--<PluginIcon></PluginIcon>-->
		<ProjectSource>https://github.com/Lightningtow/BeatSaber-BSL-SortByArtist</ProjectSource>
		<!--<ProjectHome></ProjectHome>-->
		<!--<DonateUrl></DonateUrl>-->
	</PropertyGroup>

	<!-- Plugin Dependencies -->
	<ItemGroup>
		<DependsOn Include="BSIPA" Version="^4.3.0"/>
	</ItemGroup>

	<PropertyGroup>
		<BSMTProjectType>BSIPA</BSMTProjectType>
		<GenerateManifest>true</GenerateManifest>
	</PropertyGroup>


</Project>